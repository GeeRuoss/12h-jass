---
import Layout from "../layouts/Layout.astro";
import Badge from "../components/Badge.astro";
import Suit from "../components/Suit.astro";
import Arrow from "../components/Arrow.astro";
import Glass from "../components/Glass.astro";
import Registration from "../components/Registration.astro";
import Photo from "../components/Photo.astro";
import { event, asset } from "../data/event";

const r = event.registration;
const hasSponsors = event.sponsors.main.length + event.sponsors.partners.length > 0;
const contactEmail = r.email || event.organizer.email;
const tiers = [
  { title: "Sponsors principaux", list: event.sponsors.main },
  { title: "Partenaires", list: event.sponsors.partners },
];
---

<Layout
  page="home"
  title={`${event.name} | Tournoi de jass, ${event.date.label}, Le Châble`}
  description={event.description}
>
  <aside class="studio-promo container" aria-label="Site réalisé par Ruoss Communication">
    <a class="studio-promo-link" href="https://www.ruosscommunication.com" target="_blank" rel="noopener noreferrer">
      <img src={asset("images/sponsors/ruoss-communication.svg")} alt="Ruoss Communication" width="59" height="50" />
      <span class="studio-promo-copy">
        <strong>ruosscommunication.com</strong>
        <span>Sites Internet Intelligents</span>
      </span>
    </a>
  </aside>

  <!-- === ACCUEIL === -->
  <section class="hero container">
    <div class="hero-grid">
      <div class="hero-badge">
        <Badge />
      </div>
      <div class="hero-copy">
        <p class="hero-date">
          <span>{event.date.label}</span>
          <span>{event.venue.name}, {event.venue.city}</span>
        </p>
        <h1>Les 12 heures<br />du Jass</h1>
        <p class="lead">
          Un tournoi par équipes de deux, ouvert à tous les âges et tous les niveaux. Aussi animé que
          possible mais autant sérieux que nécessaire !
        </p>
        <div class="hero-actions">
          <a class="button" href="#inscription">S'inscrire <Arrow /></a>
          <a class="button button--ghost" href="#programme">Le programme <Arrow down /></a>
        </div>
      </div>
    </div>
  </section>

  <!-- === PROGRAMME === -->
  <section id="programme" class="section container">
    <div class="programme-grid">
      <div class="programme-head" data-reveal>
        <h2>Le programme</h2>
        <p class="lead">{event.date.label}, dès 7h15 à l'{event.venue.name}.</p>
        <Photo id="saintmarc" class="programme-photo" sizes="(min-width: 1024px) 34vw, 92vw" />
      </div>
      <ol class="timeline" data-reveal>
        {event.program.map((step) => (
          <li>
            <span class="t-time">
              {step.time}
              {step.until && <small>à {step.until}</small>}
            </span>
            <div>
              <h3>{step.title}</h3>
              <p>{step.text}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- === SOIRÉE === -->
  <section id="soiree" class="section container">
    <div class="evening" data-reveal>
      <p class="evening-band">{event.evening.band}</p>
      <h2>{event.evening.title}</h2>
      <p class="lead">{event.evening.text}</p>
      <ul class="evening-facts">
        {event.evening.facts.map((fact) => (
          <li>{fact}</li>
        ))}
      </ul>
    </div>
  </section>

  <!-- === LOTS === -->
  <section id="lots" class="section container">
    <div class="section-head" data-reveal>
      <h2>De jolis lots à gagner.</h2>
      <p class="lead">{event.prizes.intro}</p>
    </div>
    <ul class="cards" data-reveal>
      {event.prizes.items.map((item) => (
        <li class:list={["card", { "card--featured": item.featured }]}>
          <Suit suit={item.suit as any} class="suit suit--tl" />
          <h3>{item.name}</h3>
          <Suit suit={item.suit as any} class="suit suit--br" />
        </li>
      ))}
    </ul>
  </section>

  <!-- === INSCRIPTION === -->
  <section id="inscription" class="section container">
    <div class="sheet" data-reveal>
      <div class="sheet-head">
        <h2>Par deux, pour tous.</h2>
        <p class="lead">
          Trouve ton partenaire, ou viens seul : le message s'écrit tout seul, tu l'envoies sur WhatsApp ou par
          e-mail. Pas d'inscription ni de paiement sur place.
        </p>
      </div>
      <Registration />
      <div class="terms">
        <div class="price">
          <span>Prix d'inscription</span>
          <strong>{r.price.person} <small>par personne</small></strong>
          <strong>{r.price.team} <small>par équipe</small></strong>
        </div>
        <p class="glass">
          <Glass />
          <span>{r.included}</span>
        </p>
        <div class="payment">
          <p>
            <strong>{r.onSite}</strong> {r.payment.text}
          </p>
          {r.payment.twintUrl || r.payment.twintQr || r.payment.slip ? (
            <div class="payment-means">
              {r.payment.twintUrl && (
                <a class="payment-twint" href={r.payment.twintUrl} target="_blank" rel="noopener noreferrer">
                  <img src={asset("images/twint-button-fr.svg")} alt="Payer avec TWINT" height="58" />
                </a>
              )}
              {r.payment.twintQr && <img src={asset(r.payment.twintQr)} alt="QR code TWINT du comité" width="160" height="160" loading="lazy" />}
              {r.payment.slip && (
                <a class="button button--ghost button--light" href={asset(r.payment.slip)} target="_blank" rel="noopener noreferrer">
                  Bulletin de versement (PDF) <Arrow diagonal />
                </a>
              )}
            </div>
          ) : (
            <p class="payment-soon">Les moyens de paiement seront bientôt disponibles.</p>
          )}
          {r.payment.slip && <p>{r.payment.slipInstructions}</p>}
        </div>
      </div>
    </div>
  </section>

  <!-- === ACCÈS === -->
  <section id="acces" class="section container">
    <div class="access-grid">
      <div class="address" data-reveal>
        <h2>Venir au Châble.</h2>
        <p class="address-lines">
          {event.venue.name}
          <span>
            {event.venue.street}<br />
            {event.venue.zip} {event.venue.city}, {event.venue.region}
          </span>
        </p>
        <p>
          <a class="button button--ghost" href={event.venue.maps} target="_blank" rel="noopener noreferrer">
            Ouvrir dans Google Maps <Arrow diagonal />
          </a>
        </p>
        <Photo id="chable" class="access-photo" sizes="(min-width: 1024px) 44vw, 92vw" />
      </div>
      <div class="ways" data-reveal>
        <div class="way">
          <h3>En train</h3>
          <p>
            Train direct depuis Martigny (ligne du St-Bernard Express), 25 minutes jusqu'à la gare du Châble.
            La salle est à une dizaine de minutes à pied de la gare.
          </p>
        </div>
        <div class="way">
          <h3>En voiture</h3>
          <p>Depuis Martigny, direction Sembrancher puis Le Châble et Verbier. Grand parking devant la salle.</p>
        </div>
        <div class="way">
          <h3>Dormir sur place</h3>
          <p>Deux hôtels sympas à quelques minutes de la salle.</p>
          <ul>
            {event.hotels.map((hotel) => (
              <li>
                <a href={hotel.url} target="_blank" rel="noopener noreferrer">{hotel.name}</a> · {hotel.note}
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- === SPONSORS === -->
  <section id="sponsors" class="section container">
    <div class="section-head" data-reveal>
      <h2>Ils soutiennent le tournoi.</h2>
      <p class="lead">
        {hasSponsors
          ? "Merci à nos sponsors et partenaires. Sans eux, pas de lots et pas de fête."
          : "Les sponsors principaux et les partenaires du tournoi seront présentés ici."}
      </p>
    </div>
    {tiers.map(
      (tier) =>
        tier.list.length > 0 && (
          <div class="sponsor-tier" data-reveal>
            <h3>{tier.title}</h3>
            <ul class="logos">
              {tier.list.map((s) => (
                <li>
                  {s.url ? (
                    <a class="logo-tile" href={s.url} target="_blank" rel="noopener noreferrer">
                      {s.logo ? <img src={asset(s.logo)} alt={s.name} loading="lazy" /> : s.name}
                    </a>
                  ) : (
                    <div class="logo-tile">{s.logo ? <img src={asset(s.logo)} alt={s.name} loading="lazy" /> : s.name}</div>
                  )}
                </li>
              ))}
            </ul>
          </div>
        ),
    )}
    {contactEmail && (
      <p class="sponsor-cta" data-reveal>
        <a class="button button--ghost" href={`mailto:${contactEmail}?subject=Sponsoring des 12 heures du Jass`}>
          Devenir sponsor <Arrow diagonal />
        </a>
      </p>
    )}
  </section>

  <!-- === RAPPEL FINAL === -->
  <section class="section container closing" data-reveal>
    <h2>Rendez-vous le {event.date.short}.</h2>
    <p class="lead">Et le soir, dès 21h, la fête est ouverte à tous avec les Magic Men. Entrée gratuite.</p>
    <a class="button" href="#inscription">Inscrire mon équipe <Arrow /></a>
  </section>
</Layout>
