---
// Inscription dans la page : le message s'écrit en direct, le visiteur l'envoie lui-même sur WhatsApp ou par e-mail.
import Arrow from "./Arrow.astro";
import WhatsAppIcon from "./WhatsAppIcon.astro";
import { event, waLink, mailLink, telHref, asset } from "../data/event";
const r = event.registration;
const label = `${event.shortName} du ${event.date.label.toLowerCase()}`;
const subject = `Inscription aux ${label}`;
const fallbackWa = waLink(r.whatsapp, r.whatsappIntro);
const fallbackMail = r.email ? mailLink(r.email, subject, r.whatsappIntro) : "";
const players = [
  { id: "1", label: "Joueur 1" },
  { id: "2", label: "Joueur 2" },
];
---

<form
  class="signup"
  id="signup"
  data-whatsapp={r.whatsapp}
  data-email={r.email}
  data-subject={subject}
  data-event={label}
  data-price-person={r.price.person}
  data-price-team={r.price.team}
  novalidate
>
  <div class="signup-fields">
    {players.map((p) => (
      <div class="player" data-player={p.id}>
        <div class="field">
          <label for={`player${p.id}`}>{p.label}</label>
          <input id={`player${p.id}`} name={`player${p.id}`} required maxlength="80" autocomplete={p.id === "1" ? "name" : "off"} placeholder="Prénom et nom" />
        </div>
        <fieldset class="field sauces">
          <legend>Sauce des pâtes de midi</legend>
          <div class="pills">
            {r.sauces.map((sauce) => (
              <label class="pill">
                <input type="radio" name={`sauce${p.id}`} value={sauce} required />
                <span>{sauce}</span>
              </label>
            ))}
          </div>
        </fieldset>
      </div>
    ))}
    <label class="check">
      <input type="checkbox" id="solo" name="solo" />
      <span>Je m'inscris seul, le comité me trouve un partenaire.</span>
    </label>
    <div class="field">
      <label for="team">Nom d'équipe <span>facultatif</span></label>
      <input id="team" name="team" maxlength="60" placeholder="Les As de Bruson" />
    </div>
    <div class="field">
      <label for="note">Une précision ? <span>facultatif</span></label>
      <input id="note" name="note" maxlength="200" placeholder="Village, question, remarque" />
    </div>
  </div>
  <div class="signup-side">
    <p class="signup-preview-label">Ton message</p>
    <p class="signup-message" id="signup-message" aria-live="polite"></p>
    <a class="button button--whatsapp" id="signup-send" href={fallbackWa} target="_blank" rel="noopener noreferrer">
      <WhatsAppIcon />
      Envoyer sur WhatsApp
      <Arrow diagonal />
    </a>
    <div class="signup-reminder" id="signup-reminder" hidden tabindex="-1" role="status">
      <p class="signup-reminder-title">Message prêt. Reste le paiement.</p>
      <p>
        Ton inscription est confirmée à réception du paiement : <strong id="signup-amount">{r.price.team} pour l'équipe</strong>.
        Par TWINT dès maintenant, ou avec le bulletin de versement ci-dessous.
      </p>
      {r.payment.twintUrl && (
        <a class="payment-twint" href={r.payment.twintUrl} target="_blank" rel="noopener noreferrer">
          <img src={asset("images/twint-button-fr.svg")} alt="Payer avec TWINT" height="58" />
        </a>
      )}
      {r.payment.slip && (
        <a class="button button--ghost" href={asset(r.payment.slip)} target="_blank" rel="noopener noreferrer">
          Bulletin de versement (PDF) <Arrow diagonal />
        </a>
      )}
      {r.payment.slip && <p>{r.payment.slipInstructions}</p>}
    </div>
    <p class="signup-others">
      {r.email && (
        <>
          Ou par e-mail à <a id="signup-mail" href={fallbackMail}>{r.email}</a>
        </>
      )}
      {r.email && r.phone && ", ou par téléphone au "}
      {!r.email && r.phone && "Ou par téléphone au "}
      {r.phone && <a href={telHref(r.phone)}>{r.phone}</a>}
      {(r.email || r.phone) && "."}
    </p>
    <p class="signup-help">
      Relis le message et envoie-le. L'inscription est confirmée à réception du paiement.
    </p>
  </div>
  <noscript>
    <p class="signup-help">
      Pour t'inscrire, envoie les noms des deux joueurs et la sauce choisie au comité sur{" "}
      <a href={fallbackWa}>WhatsApp</a>{r.email && <> ou par <a href={fallbackMail}>e-mail</a></>}.
    </p>
  </noscript>
</form>

<script>
  // === Inscription : message composé en direct, validé avant l'ouverture de WhatsApp ou de l'e-mail ===
  const form = document.getElementById("signup") as HTMLFormElement | null;
  if (form) {
    const number = (form.dataset.whatsapp || "").replace(/\D/g, "");
    const email = form.dataset.email || "";
    const subject = form.dataset.subject || "Inscription";
    const label = form.dataset.event || "12 heures du Jass";
    const field = (id: string) => document.getElementById(id) as HTMLInputElement;
    const player1 = field("player1"), player2 = field("player2"), team = field("team"), note = field("note"), solo = field("solo");
    const player2Block = form.querySelector<HTMLElement>('[data-player="2"]')!;
    const preview = document.getElementById("signup-message")!;
    const send = document.getElementById("signup-send") as HTMLAnchorElement;
    const mail = document.getElementById("signup-mail") as HTMLAnchorElement | null;
    const reminder = document.getElementById("signup-reminder")!;
    const amount = document.getElementById("signup-amount")!;
    const pricePerson = form.dataset.pricePerson || "";
    const priceTeam = form.dataset.priceTeam || "";
    const value = (input: HTMLInputElement) => input.value.trim();
    const sauce = (id: string) => (form.querySelector(`input[name="sauce${id}"]:checked`) as HTMLInputElement | null)?.value || "";
    const sauces = (id: string) => form.querySelectorAll<HTMLInputElement>(`input[name="sauce${id}"]`);
    const line = (who: string, input: HTMLInputElement, id: string) =>
      `${who} : ${value(input) || "…"} (pâtes : ${sauce(id) || "…"})`;
    const build = () =>
      [
        solo.checked
          ? `Bonjour ! Je m'inscris seul aux ${label} et je cherche un partenaire.`
          : `Bonjour ! On s'inscrit aux ${label}.`,
        !solo.checked && value(team) && `Équipe : ${value(team)}`,
        line(solo.checked ? "Joueur" : "Joueur 1", player1, "1"),
        !solo.checked && line("Joueur 2", player2, "2"),
        value(note) && `Précision : ${value(note)}`,
        "Merci !",
      ]
        .filter(Boolean)
        .join("\n");
    const update = () => {
      form.querySelectorAll<HTMLInputElement>("input").forEach((input) => input.setCustomValidity(""));
      player2Block.hidden = solo.checked;
      player2.required = !solo.checked;
      player2.disabled = solo.checked;
      sauces("2").forEach((input) => {
        input.required = !solo.checked;
        input.disabled = solo.checked;
      });
      const text = build();
      preview.textContent = text;
      send.href = `https://wa.me/${number}?text=${encodeURIComponent(text)}`;
      if (mail) mail.href = `mailto:${email}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(text)}`;
    };
    const validate = (event: Event) => {
      const required = solo.checked ? [player1] : [player1, player2];
      [player1, player2].forEach((input) => input.setCustomValidity(""));
      required.forEach((input) => input.setCustomValidity(value(input) ? "" : "Indique le prénom et le nom."));
      (solo.checked ? ["1"] : ["1", "2"]).forEach((id) => {
        const first = sauces(id)[0];
        first?.setCustomValidity(sauce(id) ? "" : "Choisis la sauce des pâtes.");
      });
      if (!form.reportValidity()) {
        event.preventDefault();
        return;
      }
      // Envoi validé : WhatsApp ou l'e-mail s'ouvre, le rappel de paiement reste sur la page.
      amount.textContent = solo.checked ? `${pricePerson} pour une personne` : `${priceTeam} pour l'équipe`;
      reminder.hidden = false;
      window.setTimeout(() => {
        reminder.scrollIntoView({ behavior: matchMedia("(prefers-reduced-motion: reduce)").matches ? "instant" : "smooth", block: "nearest" });
        reminder.focus({ preventScroll: true });
      }, 400);
    };
    form.addEventListener("input", update);
    form.addEventListener("change", update);
    send.addEventListener("click", validate);
    mail?.addEventListener("click", validate);
    update();
  }
</script>
