---
// Flèche de lien : droite par défaut, diagonale pour les liens externes, vers le bas pour les ancres.
const { diagonal = false, down = false } = Astro.props as { diagonal?: boolean; down?: boolean };
---
<svg
  class:list={["arrow", { "arrow--diagonal": diagonal, "arrow--down": down }]}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  <path d="M5 12h14M13 6l6 6-6 6" />
</svg>
